# Wildberries Review Scraper - Playwright Edition
# 支持浏览器自动化和无限滚动抓取

FROM ubuntu:22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=18
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
ENV PUPPETEER_DOWNLOAD_HOST=https://storage.googleapis.com

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    gnupg \
    ca-certificates \
    apt-transport-https \
    software-properties-common \
    # Playwright 需要的系统库
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgtk-3-0 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    xdg-utils \
    # 其他必要工具
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# 安装 Node.js 18
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm

# 设置工作目录
WORKDIR /app

# 复制 package.json
COPY package.json pnpm-lock.yaml* ./

# 安装依赖
RUN pnpm install --frozen-lockfile || pnpm install

# 安装 Playwright 浏览器
RUN npx playwright install chromium \
    --with-deps \
    || echo "Playwright install completed"

# 复制源代码
COPY server-playwright.js ./

# 暴露端口
ENV PORT=3001
EXPOSE 3001

# 环境变量配置
ENV NODE_ENV=production
ENV SCROLL_DELAY=2000
ENV MAX_SCROLLS=50

# 启动命令
CMD ["node", "server-playwright.js"]
